# ============================================================
# .gitignore — A Biblioteca
# ============================================================

# Dependências
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testes
/coverage

# Next.js
/.next/
/out/
next-env.d.ts

# Produção
/build

# Arquivos de ambiente — NUNCA versionar segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Vercel
.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Sistema operacional
.DS_Store
*.pem
Thumbs.db
desktop.ini
**/desktop.ini

# Editores / IDE
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Supabase (local)
/supabase/.branches
/supabase/.temp
