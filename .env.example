# ============================================================
# .env.example — A Biblioteca
# ============================================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA versione o .env.local — ele contém segredos.
#
# Na Vercel, configure estas mesmas variáveis em:
# Project Settings → Environment Variables
# ============================================================

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anon do Supabase (pode ser exposta no cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publica_aqui

# Chave publishable do Supabase (pública — mesma família da anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_aqui

# Chave secreta service_role (NUNCA expor no cliente — bypassa RLS)
# Usada apenas em código server-side. NÃO prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_secreta_aqui
